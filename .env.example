# Salesforce Local Sync Configuration
PORT=3000

# Local SQLite Database Path (Optional, defaults to ./data/salesforce_local.db)
# DB_PATH=./data/salesforce_local.db

# Salesforce Credentials (Optional - can also be configured via the Web Dashboard)
# SF_LOGIN_URL=https://login.salesforce.com
# SF_USERNAME=your_salesforce_username@example.com
# SF_PASSWORD=your_salesforce_password
# SF_SECURITY_TOKEN=your_security_token

# Or OAuth Connected App
# SF_INSTANCE_URL=https://yourcompany.my.salesforce.com
# SF_ACCESS_TOKEN=your_oauth_access_token
